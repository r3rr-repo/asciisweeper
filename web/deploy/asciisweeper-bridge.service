# systemd unit for the asciisweeper multiplayer bridge.
#
#   sudo cp asciisweeper-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now asciisweeper-bridge
#
# Adjust WorkingDirectory, User and the upstream flags to match the host.
#
# --servername is NOT optional here, and is the easiest thing to get wrong. Node
# verifies the upstream certificate against `servername || host`, so connecting to
# 127.0.0.1 without it checks the certificate against the IP - which a certificate
# issued for a domain name does not cover, and the handshake fails with
# "Hostname/IP does not match certificate's altnames". Passing --ca does not help;
# the identity check still uses the host. Set it to the name in the GAME SERVER's
# certificate, which is usually not the domain the site is served from.
#
# Drop --ca entirely if the game server's certificate is publicly valid (Let's
# Encrypt): the system trust store covers it. Keep it to pin a private CA, or when
# the certificate is self-signed. See ../bridge/README.md for the full table.

[Unit]
Description=asciisweeper multiplayer WebSocket bridge
After=network-online.target
Wants=network-online.target
# Start after the game server, since the bridge dials into it.
After=asciisweeper-server.service

[Service]
Type=simple
User=asciisweeper
Group=asciisweeper
WorkingDirectory=/opt/asciisweeper/web/bridge
ExecStart=/usr/bin/node bridge.mjs \
  --bind 127.0.0.1 \
  --listen 8080 \
  --upstream 127.0.0.1:4443 \
  --servername s1.example.com
Restart=on-failure
RestartSec=2

# It only needs loopback networking and its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/asciisweeper
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
